CREATE TABLE libraryManga (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sourceId INTEGER NOT NULL,
    packageName TEXT NOT NULL,
    jarFileName TEXT NOT NULL,
    extensionName TEXT NOT NULL,
    mangaUrl TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    author TEXT,
    addedAt INTEGER NOT NULL,
    UNIQUE (sourceId, mangaUrl)
);

selectAll:
SELECT * FROM libraryManga ORDER BY addedAt DESC;

selectOne:
SELECT * FROM libraryManga WHERE sourceId = ? AND mangaUrl = ?;

insertOrReplace:
INSERT OR REPLACE INTO libraryManga(sourceId, packageName, jarFileName, extensionName, mangaUrl, title, thumbnailUrl, author, addedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM libraryManga WHERE sourceId = ? AND mangaUrl = ?;

-- Updates metadata in place, keeping the autoincrement id (and addedAt) stable.
-- Used when re-adding a manga already in the library: INSERT OR REPLACE would
-- assign a fresh id and orphan any mangaCategory mappings pointing at the old one.
updateMeta:
UPDATE libraryManga
SET packageName = ?, jarFileName = ?, extensionName = ?, title = ?, thumbnailUrl = ?, author = ?
WHERE id = ?;

-- Re-points every row of one extension package at a new jar file name.
-- Used after an extension update swaps in a jar under a new name: persisted
-- rows must never reference the deleted old jar.
updateJarFileName:
UPDATE libraryManga
SET jarFileName = :newJarFileName
WHERE packageName = :packageName;
