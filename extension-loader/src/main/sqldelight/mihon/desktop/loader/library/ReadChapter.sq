CREATE TABLE readChapters (
    sourceId INTEGER NOT NULL,
    mangaUrl TEXT NOT NULL,
    chapterUrl TEXT NOT NULL,
    chapterName TEXT NOT NULL DEFAULT '',
    readAt INTEGER NOT NULL,
    PRIMARY KEY (sourceId, chapterUrl)
);

selectForManga:
SELECT * FROM readChapters WHERE sourceId = ? AND mangaUrl = ?;

selectOne:
SELECT * FROM readChapters WHERE sourceId = ? AND chapterUrl = ?;

insertOrReplace:
INSERT OR REPLACE INTO readChapters(sourceId, mangaUrl, chapterUrl, chapterName, readAt)
VALUES (?, ?, ?, ?, ?);

delete:
DELETE FROM readChapters WHERE sourceId = ? AND chapterUrl = ?;

deleteAllForManga:
DELETE FROM readChapters WHERE sourceId = ? AND mangaUrl = ?;

selectAllWithManga:
SELECT rc.*, lm.title AS mangaTitle, lm.thumbnailUrl, lm.author AS mangaAuthor, lm.packageName, lm.jarFileName, lm.extensionName
FROM readChapters rc
JOIN libraryManga lm ON rc.sourceId = lm.sourceId AND rc.mangaUrl = lm.mangaUrl
ORDER BY rc.readAt DESC;

deleteAll:
DELETE FROM readChapters;
