CREATE TABLE category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    sortOrder INTEGER NOT NULL
);

selectAll:
SELECT * FROM category ORDER BY sortOrder, id;

selectByName:
SELECT * FROM category WHERE name = ?;

selectById:
SELECT * FROM category WHERE id = ?;

insert:
INSERT INTO category(name, sortOrder) VALUES (?, ?);

rename:
UPDATE category SET name = ? WHERE id = ?;

delete:
DELETE FROM category WHERE id = ?;

updateSortOrder:
UPDATE category SET sortOrder = ? WHERE id = ?;

maxSortOrder:
SELECT COALESCE(MAX(sortOrder), 0) FROM category;

selectAllWithCounts:
SELECT category.id, category.name, category.sortOrder, COUNT(mangaCategory.mangaId) AS mangaCount
FROM category
LEFT JOIN mangaCategory ON mangaCategory.categoryId = category.id
GROUP BY category.id
ORDER BY category.sortOrder, category.id;
