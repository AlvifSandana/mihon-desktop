CREATE TABLE updateHistory (
    sourceId INTEGER NOT NULL,
    mangaUrl TEXT NOT NULL,
    mangaTitle TEXT NOT NULL,
    thumbnailUrl TEXT,
    chapterUrl TEXT NOT NULL,
    chapterName TEXT NOT NULL,
    chapterNumber REAL,
    packageName TEXT NOT NULL,
    jarFileName TEXT NOT NULL,
    baseline INTEGER NOT NULL DEFAULT 0,
    fetchedAt INTEGER NOT NULL,
    PRIMARY KEY (sourceId, chapterUrl)
);

selectAll:
SELECT * FROM updateHistory WHERE baseline = 0 ORDER BY fetchedAt DESC;

selectChapterUrls:
SELECT chapterUrl FROM updateHistory WHERE sourceId = ? AND mangaUrl = ?;

countSince:
SELECT COUNT(*) FROM updateHistory WHERE fetchedAt > ? AND baseline = 0;

insertOrIgnore:
INSERT OR IGNORE INTO updateHistory(sourceId, mangaUrl, mangaTitle, thumbnailUrl, chapterUrl, chapterName, chapterNumber, packageName, jarFileName, baseline, fetchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteOlderThan:
DELETE FROM updateHistory WHERE fetchedAt < ? AND baseline = 0;

deleteForManga:
DELETE FROM updateHistory WHERE sourceId = ? AND mangaUrl = ?;

dismissAll:
UPDATE updateHistory SET baseline = 1 WHERE baseline = 0;
